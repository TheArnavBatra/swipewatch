# Copy to .env.local and fill in. Without a TMDB key the app shows 30 sample titles.
# None of these names starts with VITE_ on purpose: a VITE_ name is sent to every visitor's browser.
# The keys stay on the server (the dev server here, the functions in api/ once deployed).

# Get a free key at https://www.themoviedb.org/settings/api (use the "API Key (v3 auth)" value).
TMDB_KEY=
# Optional: shows IMDb ratings in the details sheet. Free key at https://www.omdbapi.com/apikey.aspx
OMDB_KEY=
# Optional: turns on the AI picks (mood list and taste reading). Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a model. By default the newest stable Flash-Lite your key can use is picked.
GEMINI_MODEL=

# Two-letter country code for streaming availability. This one is not a secret.
VITE_TMDB_REGION=IN
# Optional: extra site addresses (host names, comma separated) allowed to call the API routes.
ALLOWED_ORIGINS=
